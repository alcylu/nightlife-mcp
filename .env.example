SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SERVER_NAME=nightlife-mcp
SERVER_VERSION=0.3.0

# Optional nightlife.dev Pro subscriptions (separate from VIP deposit webhook)
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_PORTAL_CONFIGURATION_ID=
STRIPE_PRO_WEBHOOK_SECRET=
DEVELOPER_SITE_URL=https://nightlife.dev
DEFAULT_CITY=tokyo
MCP_TOP_LEVEL_CITIES=tokyo,san-francisco
DEFAULT_COUNTRY_CODE=JP
NIGHTLIFE_BASE_URL=https://nightlifetokyo.com
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
MCP_HTTP_REQUIRE_API_KEY=true
MCP_HTTP_USE_DB_KEYS=true
MCP_HTTP_ALLOW_ENV_KEY_FALLBACK=true
MCP_HTTP_API_KEYS=replace-with-strong-key-1,replace-with-strong-key-2
MCP_ENABLE_RECOMMENDATIONS=false
VIP_DASHBOARD_ADMINS=ops:replace-me
VIP_DASHBOARD_SESSION_TTL_MINUTES=720
VIP_DASHBOARD_SESSION_COOKIE_NAME=vip_dashboard_session
